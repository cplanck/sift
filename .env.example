# Copy to .env.local. Never commit secrets.
BETTER_AUTH_URL=http://localhost:3003
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Neon pooled PostgreSQL URL, including ?sslmode=require
DATABASE_URL=
# Set later for the corresponding integrations. Empty values are treated as absent.
AI_GATEWAY_API_KEY=
# Optional override for both assistant and extraction; defaults: assistant Sonnet 5.5, extraction Sonnet 4.5
AI_MODEL=
# Generate once with openssl rand -base64 32. Back it up securely: changing it
# makes existing encrypted personal Gateway credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional automatic stock-photo search. Bundled food photos work without a key.
# Free Unsplash developer access: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
# Optional existing Pexels key. New key issuance is currently paused.
PEXELS_API_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local development only: set 1 and run the Inngest CLI (see IMPLEMENTATION.md)
INNGEST_DEV=0
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional HTTPS origin for callbacks only; defaults to BETTER_AUTH_URL.
# Local voice uses a separate dev agent and a named tunnel (see IMPLEMENTATION.md).
ELEVENLABS_CALLBACK_ORIGIN=
# Local tunnel launcher only; do not deploy this token.
NGROK_AUTHTOKEN=
# Generated by scripts/configure-elevenlabs.ts; server-only callback credentials.
ELEVENLABS_LLM_SECRET=
ELEVENLABS_WEBHOOK_SECRET=
