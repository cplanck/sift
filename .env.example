# Copy to .env.local. Never commit secrets.
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Neon pooled PostgreSQL URL, including ?sslmode=require
DATABASE_URL=
# Set later for the corresponding integrations. Empty values are treated as absent.
AI_GATEWAY_API_KEY=
# 32 bytes encoded as base64, for encrypting per-user Gateway credentials
CREDENTIAL_ENCRYPTION_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
